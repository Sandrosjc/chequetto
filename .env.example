# Segredo usado para assinar as sessões de login
JWT_SECRET=gere-um-segredo-longo-e-aleatorio

# Configure uma ou mais chaves do Gemini no Render
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# Alternativa: várias chaves em uma única linha, separadas por vírgula
# GEMINI_API_KEYS=AIzaSy...chave1,AIzaSy...chave2

PORT=10000

# Envio dos links de confirmação por SMTP (preferencial) ou Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=re_xxxxxxxxx
AUTH_FROM_EMAIL=Chequetto <noreply@seu-dominio-verificado.com>

# URL pública e credenciais dos provedores OAuth
PUBLIC_URL=https://chequetto-hujo.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: token para o push do editor sem redigitá-lo no modal.
# Nunca coloque o token no código ou em arquivos versionados.
GITHUB_TOKEN=
